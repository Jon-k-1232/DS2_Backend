NODE_ENV=development
# Legacy name for the JWT signing secret. Prefer JWT_SECRET below; this is kept
# only as a fallback. If set, use a long random value (>= 32 chars).
API_TOKEN='your-api-token'
# JWT signing secret (preferred). MUST be a cryptographically-random value of at
# least 32 chars (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# In production this is injected from Secrets Manager as JWT_SECRET. The server
# refuses to boot in production if this is missing/weak.
JWT_SECRET='generate-a-32+-byte-random-secret'
JWT_EXPIRATION=11h
NODE_PORT_DEV='8003'
NODE_PORT_PROD='8003'
FRONT_END_URL_DEV='http://localhost:3003'
FRONT_END_URL_PROD='https://ds2.kimmeloffice.com'
HOST_IP_DEV='0.0.0.0'
HOST_IP_PROD='0.0.0.0'

# Google OAuth Settings
GOOGLE_CLIENT_ID='your-google-oauth-client-id.apps.googleusercontent.com'
GOOGLE_WORKSPACE_DOMAIN='jimkimmel.com'
# Comma-separated list of allowed origins for CORS, e.g. http://localhost:3003,https://app.jimkimmel.com
CORS_ORIGIN='http://localhost:3003'

# Database Settings
DATABASE_USER=your-db-user
DATABASE_PASSWORD='your-db-password'
DB_DEV_HOST='your-dev-db-host'
DB_PROD_HOST='your-prod-db-host'
# Port for DB_DEV_HOST (config.js/src/utils/db.js default to 5432 if unset).
# The local sandbox Postgres runs on 5433, not 5432 — set this when pointing
# at it.
DB_DEV_PORT=5432
# Database name. Falls back to 'ds2_prod'/'ds2_dev' by NODE_ENV if unset
# (config.js). Sandbox restores use 'ds2_local'. postgrator-config.js
# (`npm run migrate`) refuses to run at all when this is 'ds2_prod' — prod is
# migrated by hand, never through postgrator.
DATABASE_NAME=ds2_dev
# Max connections in the pg pool (src/utils/db.js).
PG_POOL_MAX=20
# TLS to Postgres/RDS. By default the app pins the bundled Amazon RDS CA
# (certs/rds-global-bundle.pem) and verifies the server certificate.
#   DB_SSL_DISABLE=true             -> disable TLS entirely (plain local Postgres)
#   DB_SSL_CA_PATH=/path/to/ca.pem  -> use a different CA bundle
#   DB_SSL_REJECT_UNAUTHORIZED=false-> encrypt but skip verification (NOT for prod)
# DB_SSL_DISABLE=false
# DB_SSL_CA_PATH=./certs/rds-global-bundle.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# AWS Settings
FROM_EMAIL='your-email@domain.com'
S3_REGION='us-west-2'
# Region for SES (src/utils/email/sendEmail.js) and, when BEDROCK_REGION is
# unset, for Comprehend PII redaction (src/utils/comprehend.js) too.
AWS_REGION='us-west-2'

# S3 Bucket Settings
S3_BUCKET_NAME='your-bucket-name'
S3_ENDPOINT='your-s3-vpce-endpoint'
# S3 access keys are OPTIONAL. Leave unset in deployed environments to use the
# ECS task role (default credential chain). Set them only for local dev.
S3_ACCESS_KEY_ID='your-access-key'
S3_SECRET_ACCESS_KEY='your-secret-key'

# ----------------------------------------------------------------------------
# Bedrock / AI models
# ----------------------------------------------------------------------------
# Region for Bedrock InvokeModel calls (src/ai_integrations/bedrock/index.js).
# Also used as the Comprehend region fallback ahead of AWS_REGION.
BEDROCK_REGION='us-west-2'
# Precise/escalation-tier model for category inference + customer-name
# tiebreak, and the audit-narrative fallback model.
BEDROCK_MODEL_TIMETRACKER='us.anthropic.claude-sonnet-4-5-20250929-v1:0'
# Fast/cheap first-pass model for category inference; also the audit-narrative
# default model's own fallback.
BEDROCK_MODEL_TIMETRACKER_FAST='us.anthropic.claude-haiku-4-5-20251001-v1:0'
# Model for the optional Bedrock-generated account-audit executive summary
# (src/endpoints/accountAudit/account-audit-narrative.js). Falls back to
# BEDROCK_MODEL_TIMETRACKER_FAST, then a hardcoded Haiku model ID, if unset.
# BEDROCK_MODEL_AUDIT='us.anthropic.claude-haiku-4-5-20251001-v1:0'
# Bedrock InvokeModel rate limits, requests/minute (src/ai_integrations/bedrock/rateLimiter.js).
# Defaults are a safety margin under the account's actual Bedrock quota.
BEDROCK_RPM_HAIKU=600
BEDROCK_RPM_SONNET=120
# S3 bucket for per-call Bedrock InvokeModel audit logs (matches the bucket
# from terraform/s3/prod/main.tf; empty disables audit logging).
LLM_LOG_BUCKET='ds2-561979538576-llm-logs'
# AI / Bedrock audit logging
# When 'true', raw (PII-redacted) prompts/responses are written to the S3 LLM
# log. Default off: only metadata + a content hash are stored.
# LLM_LOG_RAW=false

# ----------------------------------------------------------------------------
# Time-tracker AI pipeline (auto-ingest of uploaded XLSX trackers)
# ----------------------------------------------------------------------------
# Rollout flag. Allowed: off | test | on (src/endpoints/timesheets/auto-ingest-runner.js).
TIME_TRACKER_AI_FEATURE_FLAG=off
# Comma-separated account_ids allowed to run the pipeline when the flag is 'test'.
TIME_TRACKER_AI_TEST_ACCOUNT_IDS=
# Combined-confidence threshold (0..1) at/above which a row is auto-inserted
# into customer_transactions instead of held for review.
AUTO_INSERT_CONFIDENCE_THRESHOLD=0.85
# Max timesheet entries processed concurrently per auto-ingest run.
AUTO_INGEST_CONCURRENCY=8
# When '1', send the uploading user a success email after auto-ingest
# finishes (src/endpoints/timeTracking/timeTracking-router.js). Default off.
# TIME_TRACKER_SEND_USER_SUCCESS_EMAILS=1
# Comma-separated fallback admin emails for auto-ingest/validation
# notifications when no account-specific recipients are configured
# (src/timeTrackerValidation/notifications.js).
TIME_TRACKING_ADMIN_EMAILS=

# Customer/category matching thresholds used by the auto-ingest pipeline
# (src/ai_integrations/customerMatching.js, categoryInference.js,
# customerHistoricalPatterns.js, src/endpoints/timesheets/auto-ingest-orchestrator.js).
# Fuzzy-match floor below which a customer name is not considered a candidate.
CUSTOMER_MATCH_THRESHOLD=0.62
# Fuzzy score at/above which customer matching skips the LLM tiebreak.
CUSTOMER_LLM_SKIP_THRESHOLD=0.90
# Fuzzy score the orchestrator treats as a high-confidence customer match.
CUSTOMER_FUZZY_HIGH_THRESHOLD=0.90
# Few-shot examples pulled from customer history for category-inference prompts.
CUSTOMER_FEWSHOT_LIMIT=8
# Days of transaction history considered for a customer's historical patterns.
CUSTOMER_HISTORY_LOOKBACK_DAYS=365
# Minimum historical-example count before a category is treated as deterministic.
MIN_DETERMINISTIC_JOB_COUNT=5
# Category-inference confidence at/above which the fast (Haiku) result is
# accepted without escalating to the precise (Sonnet) model.
CATEGORY_ESCALATION_THRESHOLD=0.75
# Cap on job types listed in the category-inference prompt (keeps token count bounded).
MAX_JOB_TYPES_IN_PROMPT=150
# Few-shot examples included in the auto-ingest-orchestrator prompt. NOTE:
# distinct from CUSTOMER_FEWSHOT_LIMIT above — different pipeline stage, its
# own knob, different default.
FEW_SHOT_LIMIT=5

# ----------------------------------------------------------------------------
# Time-tracker template builder (src/endpoints/timeTracking/template-builder.js)
# ----------------------------------------------------------------------------
# Password protecting the generated XLSX template's locked cells/sheet.
TEMPLATE_PROTECT_PASSWORD='jka-internal'
# Window (ms) within which same-day rows are collapsed when building the template.
TEMPLATE_COLLAPSE_WINDOW_MS=60000
# Max data rows written into a generated template before truncating.
TEMPLATE_MAX_DATA_ROWS=1500

# Firm-owned customers (the firm's own entities that staff log internal time
# against): their auto-inserted time is always written NON-billable, hours kept
# for analytics. Customers named like the account or like a tracker Entity used
# by 2+ employees are detected automatically; list any others here. Prod: 6.
INTERNAL_CUSTOMER_IDS=
# Customer-matching / ingestion tuning (defaults shown)
# CUSTOMER_MATCH_MIN_MARGIN=0.08
# CUSTOMER_MATCH_MIN_SHARED_TOKENS=2
# CUSTOMER_ALIAS_MIN_CONFIRMATIONS=2
# INTERNAL_ENTITY_MIN_EMPLOYEES=2
# TRACKER_ENTRY_LOOKBACK_DAYS=7
# Firm billing calendar (Create Invoice dates the statement in this zone)
BILLING_TIMEZONE=America/Phoenix
